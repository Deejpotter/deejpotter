{
  "name": "deejpotter",
  "version": "3.0.1",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "docs": "typedoc",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint --fix . --ext .ts,.tsx,.js,.jsx",
    "lint:scss": "stylelint src/**/*.{css,scss}",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:a11y": "playwright test e2e/a11y.spec.ts --project=chromium",
    "a11y:report": "playwright show-report"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "last 2 Edge versions",
    "not IE 11"
  ],
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "resolutions": {
    "@babel/helpers": "^7.26.10",
    "@babel/runtime": "^7.26.10",
    "form-data": "^4.0.4",
    "cross-spawn": "^7.0.5",
    "glob": "^10.5.0",
    "js-yaml": "^3.14.2",
    "mdast-util-to-hast": "^13.2.1",
    "nanoid": "^3.3.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "sass": "^1.105.0",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}

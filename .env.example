# Example environment variables

# Stripe — payments for 3D printing quotes
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_<your-stripe-secret-key>
NEXT_PUBLIC_STRIPE_KEY=pk_test_<your-stripe-publishable-key>

# Stripe Webhook Secret — for verifying payment events
# Set via Stripe CLI: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Or get from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-secret>

# Clerk Authentication — single sign-on for shop, dashboard, etc.
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<your-clerk-key>
CLERK_SECRET_KEY=sk_test_<your-clerk-secret>

# Optional: Custom URLs for Clerk hosted pages
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Clerk Webhook Secret — for verifying Clerk webhook events (user sync)
# Set via: see https://clerk.com/docs/webhooks
CLERK_WEBHOOK_SECRET=whsec_<your-clerk-webhook-secret>

# Resend — email notifications for quotes and leads
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_<your-resend-key>

# Admin email — where admin notifications are sent
ADMIN_EMAIL=deejpotter@gmail.com

# Site URL — used for Stripe redirects and SEO
# Set to https://deejpotter.com in production
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# MongoDB — quotes, shop products/orders, users, leads
DB_NAME=deejpotter

# Allowed MongoDB collections for /api/mongo-crud (comma-separated)
ALLOWED_COLLECTIONS=test,users

# 3D Printing Quote Storage — where uploaded STL files are saved
# Defaults to ./data/3d-printing-quotes
# QUOTE_STORAGE_DIR=C:\path\to\quotes

# Materials Config — path to printing materials JSON
# Defaults to ./config/printing-materials.json
# PRINTING_MATERIALS_CONFIG=C:\path\to\printing-materials.json

# OpenRouter API (optional)
OPENROUTER_API_KEY=sk-or-v1-<your-key>

# Cloudflare R2 — persistent file storage for quote uploads, CAD files, etc.
# S3-compatible keys (NOT the cfat_ API token). Get these from:
#   Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=<your-account-id>
R2_ACCESS_KEY_ID=<your-access-key-id>
R2_SECRET_ACCESS_KEY=<your-secret-access-key>
R2_BUCKET_NAME=deejpotter
# Optional: custom endpoint (defaults to <account_id>.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Environment indicator
NEXT_PUBLIC_ENV="development"

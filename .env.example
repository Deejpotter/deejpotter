# Example environment variables

# Stripe — payments for 3D printing quotes
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_<your-stripe-secret-key>
NEXT_PUBLIC_STRIPE_KEY=pk_test_<your-stripe-publishable-key>

# Stripe Webhook Secret — for verifying payment events
# Set via Stripe CLI: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Or get from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-secret>

# Clerk Authentication — single sign-on for shop, dashboard, etc.
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<your-clerk-key>
CLERK_SECRET_KEY=sk_test_<your-clerk-secret>

# Optional: Custom URLs for Clerk hosted pages
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Site URL — used for Stripe redirects and SEO
# Set to https://deejpotter.com in production
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Gelato Print-on-Demand — for POD product fulfillment
GELATO_API_KEY=<your-gelato-api-key>

# MongoDB — for user app data only (todos, leads, etc.)
# The shop no longer uses MongoDB (Stripe handles products/orders)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="deejpotter"

# 3D Printing Quote Storage — where uploaded STL files are saved
# Defaults to ./data/3d-printing-quotes
# QUOTE_STORAGE_DIR=C:\path\to\quotes

# Materials Config — path to printing materials JSON
# Defaults to ./config/printing-materials.json
# PRINTING_MATERIALS_CONFIG=C:\path\to\printing-materials.json

# OpenRouter API (optional)
OPENROUTER_API_KEY=sk-or-v1-<your-key>

# Environment indicator
NEXT_PUBLIC_ENV="development"
